<!doctype html><html><head><title>{{ seo.title }}</title><link rel="canonical" href="{{ seo.canonical }}">{% if seo.prev %}<link rel="prev" href="{{ seo.prev }}">{% endif %}{% if seo.next %}<link rel="next" href="{{ seo.next }}">{% endif %}</head><body class="default"><h1>{{ page.title }}</h1><p class="self">{{ page.url }}</p>{{ content }}{% if paginator %}<ul class="listing">{% for item in paginator.items %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% endfor %}</ul><p class="count">{{ paginator.page }}/{{ paginator.totalPages }} of {{ paginator.totalItems }}</p><p class="jekyll">{{ paginator.posts.size }} {{ paginator.total_pages }} {{ paginator.next_page_path }}</p>{% render 'pagination', paginator: paginator %}{% endif %}</body></html>
