{% if paginator.totalPages > 1 %}<nav class="pagination">{% if paginator.previousUrl %}<a rel="prev" href="{{ paginator.previousUrl }}">Previous</a>{% endif %}{% for p in paginator.pages %}{% if p.current %}<span class="current">{{ p.number }}</span>{% else %}<a href="{{ p.url }}">{{ p.number }}</a>{% endif %}{% endfor %}{% if paginator.nextUrl %}<a rel="next" href="{{ paginator.nextUrl }}">Next</a>{% endif %}</nav>{% endif %}
